{
  "name": "playwright-pom-harness",
  "version": "3.0.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Portable Playwright POM skills, lifecycle hooks and package validation.",
  "scripts": {
    "check:syntax": "node scripts/validate-package.mjs syntax",
    "check:json": "node scripts/validate-package.mjs json",
    "check:links": "node scripts/validate-package.mjs links",
    "check:privacy": "node scripts/validate-package.mjs privacy",
    "check:secrets": "node scripts/validate-package.mjs secrets",
    "check:provenance": "node scripts/validate-package.mjs provenance",
    "check:publication": "node scripts/validate-package.mjs publication",
    "check:conventions": "node scripts/check-conventions.mjs --root examples --fail-on-warn",
    "test:conventions": "node --test harness-tests/conventions.test.mjs",
    "test:validation": "node --test harness-tests/package-validation.test.mjs",
    "test:fetch": "node scripts/fetch-ado-suite.mjs --self-test",
    "typecheck:examples": "node examples/node_modules/typescript/bin/tsc --project examples/tsconfig.json --noEmit",
    "test": "node --test harness-tests/*.test.mjs",
    "test:roots": "node --test harness-tests/skill-roots.test.mjs",
    "test:skill-proof": "node --test harness-tests/skill-proof-assessment.test.mjs",
    "test:adoption": "node --test harness-tests/adoption.test.mjs",
    "test:local-source": "node --test harness-tests/local-source.test.mjs",
    "test:cli-spike": "node --test harness-tests/cli-spike-assessment.test.mjs harness-tests/cli-spike-profile.test.mjs",
    "test:core": "node --test harness-tests/execution-inputs.test.mjs harness-tests/execution-results.test.mjs",
    "probe:cli": "node scripts/spikes/playwright-cli/probe.mjs",
    "test:browser": "node --test harness-tests/browser-policy.test.mjs",
    "probe:browser": "node scripts/probes/browser.mjs",
    "test:api": "node --test harness-tests/api-runtime.test.mjs"
  },
  "files": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "VERSION",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".env.example",
    ".gitignore",
    ".claude/settings.json",
    ".claude/skills",
    ".agentex/page-map/README.md",
    ".agentex/page-map/_template.md",
    "scripts",
    "docs",
    "harness-tests",
    "examples",
    "resources/Queries/README.md",
    "resources/apisCollections/README.md",
    ".agents/skills",
    ".claude-plugin/plugin.json"
  ]
}
