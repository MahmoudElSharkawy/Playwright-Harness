  "sqlserverCatalog": {
    "id": "sqlserverCatalog",
    "title": "A catalog SQL Server query returns the bound observation",
    "description": "One row returns the bound observation value 42",
    "expected": "PASS",
    "definition": {
      "family": "database",
      "operation": {
        "id": "observe",
        "target": "sqlserver",
        "source": {
          "kind": "catalog",
          "reference": "synthetic-observation",
          "version": "1.0.0"
        },
        "sql": "SELECT @value AS Observed",
        "parameters": [
          {
            "name": "value",
            "input": "value",
            "type": "int"
          }
        ],
        "checks": [
          {
            "id": "count",
            "select": {
              "from": "rowCount",
              "path": []
            },
            "equals": 1
          },
          {
            "id": "expected",
            "select": {
              "from": "rows",
              "path": [
                0,
                "Observed"
              ]
            },
            "equals": {
              "$input": "value"
            }
          }
        ]
      },
      "values": [
        {
          "name": "value",
          "type": "number",
          "sensitivity": "public",
          "value": 42
        }
      ]
    }
  },
