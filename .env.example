# Template for the local secrets file — commit THIS file, never .env itself.
# Setup: copy this file to `.env` at the repo root and fill in the real values.
# `.env` is gitignored and is loaded by dotenv at the top of playwright.config.ts;
# src/config/*.ts reads these keys via process.env.

# ── Azure DevOps — consumed by scripts/fetch-ado-suite.mjs, scripts/ado-pr.mjs,
#    scripts/publish-ado-results.mjs (CLI flags override these).
AZURE_ORG=
# ...or set AZURE_URL to a full collection URL instead of AZURE_ORG:
# AZURE_URL=https://dev.azure.com/your-org
AZURE_PROJECT=
AZURE_TEST_PLAN_ID=
# PAT with Work Items (read/write), Test Management (read/write), and Code (read/write
# for PR creation) scopes. AZURE_DEVOPS_EXT_PAT is honored as an alternative key.
AZURE_PAT=

# ── Database access — consumed by src/utils/DBActions.ts via src/config/databases.ts.
DB_USER=
DB_PASSWORD=
# sqlcmd's native password variable — set to the same value as DB_PASSWORD if any
# tooling in your project shells out to sqlcmd.
SQLCMDPASSWORD=

# DB coordinates — not secrets, but environment-specific; single source of truth.
APP_DB_SERVER=
APP_DB_PORT=
APP_DB_NAME=

# ── Application under test — pre-existing credentials are secrets and live ONLY here
#    (self-invented business inputs live in resources/testData/*.json instead — see
#    the test-data skill).
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=
