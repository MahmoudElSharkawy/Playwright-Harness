# Template for the local secrets file — commit THIS file, never .env itself.
# Setup: copy this file to `.env` at the project root and fill in the real values.
# `.env` is gitignored, loaded by dotenv at the top of playwright.config.ts and read by
# the harness commands; a variable already set in the shell wins over the file.
# Destinations (URLs, database servers) are not secrets: they live in
# .harness/targets.json, which src/config/targets.ts reads. After configuring targets,
# `npx --no pom-harness check --add-env-keys` appends the empty keys they need here.

# ── Azure DevOps — once .harness/integrations.json is configured, it names its PAT
#    variable and the other keys in this section are not read. Without it, the
#    scripts read these keys, and their CLI flags override them.
AZURE_ORG=
# ...or set AZURE_URL to a full collection URL instead of AZURE_ORG:
# AZURE_URL=https://dev.azure.com/your-org
AZURE_PROJECT=
# PAT with Work Items (read/write), Test Management (read/write), and Code (read/write
# for PR creation) scopes. AZURE_DEVOPS_EXT_PAT is honored as an alternative key.
AZURE_PAT=

# ── Database access — consumed by src/utils/DBActions.ts via src/config/databases.ts.
# A database target names the variable that holds its credentials as JSON, for
# connectionRef "env:APP_DB":  APP_DB={"user":"<user>","password":"<password>"}
# (single-quote the whole value if the password contains #). A database without a
# target uses the shared keys below.
DB_USER=
DB_PASSWORD=
# sqlcmd's native password variable — set to the same value as DB_PASSWORD if any
# tooling in your project shells out to sqlcmd.
SQLCMDPASSWORD=
# Optional per-machine overrides of a target's coordinates (target appDb → APP_DB_*):
# APP_DB_SERVER=
# APP_DB_PORT=
# APP_DB_NAME=

# ── Application under test — pre-existing credentials are secrets and live ONLY here
#    (self-invented business inputs live in resources/testData/*.json instead — see
#    the test-data skill).
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=
